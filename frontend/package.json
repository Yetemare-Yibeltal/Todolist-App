{
  "name": "todolist-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade todo list application with Next.js 14, TypeScript, and Tailwind CSS",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "start:staging": "NODE_ENV=staging next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "analyze": "ANALYZE=true next build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pre-commit": "npm run format && npm run lint && npm run type-check",
    "pre-push": "npm run test && npm run build",
    "clean": "rm -rf .next node_modules coverage storybook-static",
    "build:analyze": "next build --analyze",
    "build:prod": "NODE_ENV=production next build",
    "export": "next export",
    "vercel-build": "next build",
    "i18n:extract": "next-translate extract",
    "i18n:compile": "next-translate compile",
    "security:audit": "npm audit --production --json > security-audit.json",
    "performance:test": "lighthouse http://localhost:3000 --output=json --output-path=./performance-report.json",
    "dependencies:update": "ncu -u && npm install",
    "dependencies:check": "ncu",
    "docker:build": "docker build -t todolist-frontend .",
    "docker:run": "docker run -p 3000:3000 todolist-frontend"
  },
  "dependencies": {
