NODE_ENV=development
PORT=5000
API_VERSION=v1
API_PREFIX=/api
HOST=0.0.0.0
SHUTDOWN_TIMEOUT=10000

MONGODB_URI=mongodb://localhost:27017/todolist
MONGODB_URI_PROD=mongodb://localhost:27017/todolist_prod
MONGODB_URI_TEST=mongodb://localhost:27017/todolist_test
MONGODB_OPTIONS_RETRY_WRITES=true
MONGODB_OPTIONS_W=1
MONGODB_OPTIONS_JOURNAL=true
MONGODB_OPTIONS_READ_PREFERENCE=primaryPreferred
MONGODB_OPTIONS_MAX_POOL_SIZE=10
MONGODB_OPTIONS_MIN_POOL_SIZE=2
MONGODB_OPTIONS_MAX_IDLE_TIME_MS=300000
MONGODB_OPTIONS_CONNECT_TIMEOUT_MS=30000
MONGODB_OPTIONS_SOCKET_TIMEOUT_MS=45000
MONGODB_OPTIONS_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_OPTIONS_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_OPTIONS_APP_NAME=TodoListAPI

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379
REDIS_EXPIRE_TIME=3600
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

JWT_SECRET=your-super-secret-jwt-key-change-in-production-1234567890
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-0987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=todolist-api
JWT_AUDIENCE=todolist-app
JWT_ALGORITHM=HS256

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@todolist.com
EMAIL_VERIFICATION_SUBJECT=Verify Your Email
EMAIL_VERIFICATION_TEMPLATE=email-verification
EMAIL_RESET_SUBJECT=Reset Your Password
EMAIL_RESET_TEMPLATE=password-reset
EMAIL_WELCOME_SUBJECT=Welcome to TodoList
EMAIL_WELCOME_TEMPLATE=welcome
EMAIL_INVITE_SUBJECT=You're Invited
EMAIL_INVITE_TEMPLATE=invite

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_STRICT_WINDOW=60
RATE_LIMIT_STRICT_MAX=50
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_API_MAX=1000

BCRYPT_ROUNDS=12
CSRF_ENABLED=false
CORS_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
HELMET_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000
HELMET_HSTS_INCLUDE_SUBDOMAINS=true
HELMET_HSTS_PRELOAD=true

SESSION_SECRET=your-session-secret-change-in-production-abcdefghijklmnop
SESSION_MAX_AGE=604800000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false

COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=604800000
COOKIE_DOMAIN=localhost

UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
UPLOAD_DESTINATION=./uploads
UPLOAD_TEMP_DIR=./temp
UPLOAD_FILE_NAME_LENGTH=16

SWAGGER_ENABLED=true
SWAGGER_TITLE=TodoList API
SWAGGER_DESCRIPTION=Enterprise-grade TodoList API with authentication and real-time features
SWAGGER_VERSION=1.0.0
SWAGGER_BASE_PATH=/api/v1

LOG_LEVEL=debug
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
LOG_FORMAT=json
LOG_RETENTION_DAYS=30
LOG_COMPRESS=true

WS_ENABLED=true
WS_PATH=/socket.io
WS_CORS_ORIGIN=http://localhost:3000
WS_MAX_HTTP_BUFFER_SIZE=1000000
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=5000

CACHE_TTL=3600
CACHE_CHECK_PERIOD=600
CACHE_MAX_SIZE=1000
CACHE_PREFIX=todolist:
CACHE_ENABLED=true

PUSH_NOTIFICATION_ENABLED=false
PUSH_NOTIFICATION_KEY=your-push-notification-key
SMS_ENABLED=false
SMS_ACCOUNT_SID=your-twilio-sid
SMS_AUTH_TOKEN=your-twilio-token
SMS_FROM_NUMBER=+1234567890

QUEUE_ENABLED=true
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_CONCURRENCY=5
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000
QUEUE_STALLED_INTERVAL=30000
QUEUE_MAX_STALLED_COUNT=3

BACKUP_ENABLED=true
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 0 * * *

FEATURE_TEAM_COLLABORATION=true
FEATURE_ATTACHMENTS=true
FEATURE_COMMENTS=true
FEATURE_SUBTASKS=true
FEATURE_LABELS=true
FEATURE_PRIORITY=true
FEATURE_DUE_DATE=true
FEATURE_REMINDERS=true
FEATURE_RECURRING=true
FEATURE_TEMPLATES=true
FEATURE_ARCHIVE=true
FEATURE_TRASH=true
FEATURE_STATS=true
FEATURE_REPORTS=true
FEATURE_EXPORT=true
FEATURE_IMPORT=true
FEATURE_SEARCH=true
FEATURE_FILTERS=true
FEATURE_SORTS=true
FEATURE_PAGINATION=true
FEATURE_RATE_LIMITING=true
FEATURE_REQUEST_LOGGING=true
FEATURE_ERROR_LOGGING=true
FEATURE_PERFORMANCE_LOGGING=true

I18N_ENABLED=true
I18N_DEFAULT_LOCALE=en
I18N_FALLBACK_LOCALE=en
I18N_LOCALES=en,es,fr,de,zh,ja

TIMEZONE=UTC
DATE_FORMAT=YYYY-MM-DD
DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss

DEV_TOOLS_ENABLED=true
DEV_SEED_DATABASE=false
DEV_CLEAR_CACHE_ON_START=false
DEV_LOG_SQL=false
DEV_AUTO_MIGRATE=false

WORKERS_ENABLED=false
APP_NAME=TodoList Pro
FRONTEND_URL=http://localhost:3000
SUPPORT_EMAIL=support@todolist.com