{
  "name": "todolist-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade backend API for todolist application with authentication, authorization, and real-time features",
  "main": "dist/server.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "dev:debug": "cross-env NODE_ENV=development nodemon --inspect=0.0.0.0:9229 --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:watch": "tsc --watch --project tsconfig.build.json",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "start:staging": "cross-env NODE_ENV=staging node dist/server.js",
    "start:cluster": "cross-env NODE_ENV=production node dist/cluster.js",
    "lint": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "cross-env NODE_ENV=test jest --coverage --verbose",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:e2e": "cross-env NODE_ENV=test jest --config jest.e2e.config.js --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.integration.config.js --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --coverageDirectory=coverage",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "db:reset": "ts-node -r tsconfig-paths/register scripts/reset-db.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "db:rollback": "ts-node -r tsconfig-paths/register scripts/rollback.ts",
    "db:create": "ts-node -r tsconfig-paths/register scripts/create-db.ts",
    "db:drop": "ts-node -r tsconfig-paths/register scripts/drop-db.ts",
    "cache:clear": "ts-node -r tsconfig-paths/register scripts/clear-cache.ts",
    "logs:rotate": "ts-node -r tsconfig-paths/register scripts/rotate-logs.ts",
    "health:check": "ts-node -r tsconfig-paths/register scripts/health-check.ts",
    "backup:create": "ts-node -r tsconfig-paths/register scripts/backup.ts",
    "backup:restore": "ts-node -r tsconfig-paths/register scripts/restore.ts",
    "encrypt:env": "ts-node -r tsconfig-paths/register scripts/encrypt-env.ts",
    "decrypt:env": "ts-node -r tsconfig-paths/register scripts/decrypt-env.ts",
    "validate:env": "ts-node -r tsconfig-paths/register scripts/validate-env.ts",
    "validate:schemas": "ts-node -r tsconfig-paths/register scripts/validate-schemas.ts",
    "perf:test": "ts-node -r tsconfig-paths/register scripts/performance-test.ts",
    "audit:deps": "npm audit --production --json > audit-report.json",
    "outdated:deps": "npm outdated --json > outdated-report.json",
    "pre-commit": "npm run lint && npm run test && npm run format",
    "pre-push": "npm run build && npm run test:integration",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.484.0",
    "@aws-sdk/s3-request-presigner": "^3.484.0",
    "@prisma/client": "^5.7.0",
    "@redis/client": "^1.5.14",
    "@sendgrid/mail": "^7.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^4.10.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@types/validator": "^13.11.9",
    "@types/winston": "^2.4.4",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "mongoose-sequence": "^6.0.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^9.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.13",
    "socket.io": "^4.6.2",
    "socket.io-client": "^4.6.2",
    "supertest": "^6.3.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "typedi": "^0.10.0",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^29.5.11",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^26.4.0",
    "@types/socket.io": "^3.0.2",
    "@types/socket.io-client": "^3.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.0.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "typescript-transform-paths": "^3.4.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "redis",
    "jwt",
    "authentication",
    "real-time",
    "socketio",
    "todolist",
    "api"
  ],
  "author": "Yetemare Yibeltal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yetemare-Yibeltal/Todolist-App.git"
  },
  "bugs": {
    "url": "https://github.com/Yetemare-Yibeltal/Todolist-App/issues"
  },
  "homepage": "https://github.com/Yetemare-Yibeltal/Todolist-App#readme"
}
